# Copy this file to ".env" and fill it in.
# These values stay server-side (read by the Vite dev middleware in
# server/extractPlugin.js, and by api/extract.js on Vercel). They are NEVER
# exposed to the browser. Do NOT add a VITE_ prefix — that would leak them into
# client code.

# Required: your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: a shared passphrase that gates the extraction + sync endpoints.
# Leave it UNSET for open local dev. SET it when you deploy publicly (e.g. on
# Vercel) so only people who know it can spend your API budget / storage. The
# app asks for it once and remembers it on the device.
# APP_PASSPHRASE=choose-a-long-random-phrase

# Optional: cloud sync across devices. Provisioned automatically when you add an
# Upstash Redis store in the Vercel dashboard (Storage tab) — Vercel injects
# these. For LOCAL dev sync, run `vercel env pull .env.local` or paste them here.
# (No VITE_ prefix — they stay server-side.)
# KV_REST_API_URL=https://your-db-xxxxx.upstash.io
# KV_REST_API_TOKEN=your-rest-token
